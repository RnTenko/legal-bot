# ─── LLM-прокси (OpenAI-совместимый) ───
LLM_BASE_URL=http://deepseek-bridge:8000/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek-v4.1-flash

# ─── Данные ───
DATA_DIR=./data

# ─── Параметры генерации ───
TEMPERATURE=0.1
MAX_TOKENS=2048
MAX_WORKERS=4

# ─── Параметры поиска (RAG) ───
TOP_K=10
CHUNKER=semantic
EMB_MODEL=BAAI/bge-m3
RERANKER_MODEL=Qwen3-Reranker-8B
RERANKER_TOP_N=5
