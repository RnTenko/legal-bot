# Prod: backend serves the frontend on the same origin, /api already works.
# Dev: vite proxies /api → localhost:8000 (see vite.config.ts).
# Override only if you point at a different backend.
# VITE_API_BASE_URL=http://localhost:8000/api

# Enable built-in mock API (no backend required). true | false
VITE_USE_MOCK=false
